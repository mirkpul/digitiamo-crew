{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "autoMemoryDirectory": "{{CREW_HOME}}/agents/{{NAME}}/memory",
  "crossSessionInbound": "accept",
  "permissions": {
    "allow": [
      "Read",
      "Edit(state/**)",
      "Write(state/**)",
      "Edit(proposals/**)",
      "Write(proposals/**)",
      "Edit(memory/**)",
      "Write(memory/**)",
      "mcp__claude_ai_Gmail__create_draft",
      "mcp__claude_ai_Gmail__update_draft",
      "mcp__gworkspace__draft_gmail_message"
    ],
    "ask": [
      "mcp__claude_ai_Gmail__send_message",
      "mcp__claude_ai_Gmail__reply",
      "mcp__claude_ai_Gmail__forward",
      "mcp__gworkspace__send_gmail_message",
      "mcp__gworkspace__send_message",
      "mcp__claude_ai_ClickUp__clickup_create_task",
      "mcp__claude_ai_ClickUp__clickup_update_task",
      "mcp__claude_ai_ClickUp__clickup_create_task_comment",
      "mcp__claude_ai_ClickUp__clickup_send_chat_message",
      "mcp__claude_ai_ClickUp__clickup_execute_operator",
      "mcp__claude_ai_Google_Calendar__create_event",
      "mcp__claude_ai_Google_Calendar__update_event",
      "mcp__claude_ai_Google_Calendar__respond_to_event",
      "mcp__claude_ai_Google_Drive__share_file",
      "mcp__claude_ai_Google_Drive__update_file"
    ],
    "deny": [
      "Edit(CLAUDE.md)",
      "Write(CLAUDE.md)",
      "Edit(.claude/**)",
      "Write(.claude/**)",
      "mcp__claude_ai_Gmail__trash_message",
      "mcp__claude_ai_Gmail__trash_thread",
      "mcp__claude_ai_Gmail__delete_draft",
      "mcp__claude_ai_ClickUp__clickup_delete_task",
      "mcp__claude_ai_ClickUp__clickup_delete_comment",
      "mcp__claude_ai_Google_Calendar__delete_event",
      "mcp__claude_ai_Google_Drive__trash_file",
      "mcp__gworkspace__manage_drive_access",
      "mcp__gworkspace__set_drive_file_permissions"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [{ "type": "command", "command": "{{CREW_HOME}}/lib/hooks/precompact.sh" }]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [{ "type": "command", "command": "{{CREW_HOME}}/lib/hooks/session-context.sh" }]
      }
    ]
  }
}
