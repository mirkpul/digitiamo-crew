{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "env": {
    "CLAUDE_AUTOCOMPACT_PCT_OVERRIDE": "60"
  },
  "crossSessionInbound": "accept",
  "permissions": {
    "allow": [
      "Read",
      "Bash(../bin/crewctl *)",
      "Bash(git status*)",
      "Bash(git -C ../agents *)",
      "Bash(git -C .. add *)",
      "Bash(git -C .. commit *)",
      "Bash(git diff*)",
      "Bash(git log*)",
      "Bash(git add *)",
      "Bash(git commit *)",
      "Edit(../agents/**)",
      "Edit(../template/**)",
      "Edit(state/**)"
    ],
    "deny": [
      "Bash(git push*)",
      "Bash(rm -rf *)"
    ]
  },
  "hooks": {
    "PreCompact": [
      {
        "matcher": "",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../lib/hooks/precompact.sh"
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "startup|resume|compact",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/../lib/hooks/session-context.sh"
          }
        ]
      }
    ]
  }
}
